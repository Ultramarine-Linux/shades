FROM ghcr.io/ultramarine-linux/desktop-bootc:latest

RUN --mount=type=cache,target=/var/cache dnf do -y \
    --no-best \
    --allowerasing \
    --action=remove \
        ultramarine-release-identity-basic \
        anthy \
        ibus-anthy \
        virtualbox-guest-additions \
        foot
# TODO: use kitty, switch sway defaults to kitty
    --action=install \
        ultramarine-release-identity-sway-shade \
        @sway-desktop-environment \
       @ultramarine-product-common \
       @ultramarine-desktop-product-common \
       sddm \
       rofi-wayland \
       ultramarine-backgrounds-compat \
       wl-clipboard \
       fontawesome-6-free-fonts \
       fontawesome-6-brands-fonts \
       rsms-inter-fonts \
       ibus-setup \
       pavucontrol
